{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Telldo task and list proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "summary",
    "idempotency_key",
    "risk",
    "actions"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "risk": {
      "type": "string",
      "enum": [
        "low",
        "high"
      ]
    },
    "actions": {
      "type": "array",
      "minItems": 0,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "target_id",
          "temp_id",
          "expected_version",
          "patch"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "create_list",
              "create",
              "update",
              "complete",
              "uncomplete",
              "reschedule",
              "delete",
              "add_subtask",
              "set_tags",
              "create_recurring",
              "update_recurring"
            ]
          },
          "target_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ]
          },
          "temp_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "description": "Required for create_list; unique within this proposal. Task list_id may reference an earlier create_list temp_id."
          },
          "expected_version": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "patch": {
            "type": "array",
            "description": "Changed fields only. create_list accepts name and optional color only. Task actions accept task fields only; list_id may reference an earlier create_list temp_id. Empty array for complete, uncomplete or delete. Null explicitly clears nullable task fields. create_recurring combines task fields with rrule, dtstart, tzid, until or count. RRULE contains only the repeat pattern; end limits use separate until/count fields.",
            "maxItems": 24,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "key",
                "value"
              ],
              "properties": {
                "key": {
                  "type": "string",
                  "enum": [
                    "list_id",
                    "parent_id",
                    "title",
                    "notes",
                    "status",
                    "priority",
                    "due_kind",
                    "due_date",
                    "due_at",
                    "time_zone",
                    "planned_date",
                    "reminder_at",
                    "sort_order",
                    "tags",
                    "name",
                    "color",
                    "rrule",
                    "dtstart",
                    "tzid",
                    "until",
                    "count"
                  ]
                },
                "value": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
